# PopTV R8 rules. Libraries (Room, Hilt, Media3, OkHttp, Coil, kotlinx.serialization, WorkManager)
# ship their own consumer rules; only app-specific needs are listed here.

# Enum names are persisted in DataStore (settings) and must stay stable across releases.
-keepclassmembers enum pm.koc.poptv.** {
    public static final ** *;
    public static **[] values();
    public static ** valueOf(java.lang.String);
}

# Readable stack traces in crash reports / logcat.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile
