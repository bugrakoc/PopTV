<?xml version="1.0" encoding="utf-8"?>
<!-- Many IPTV providers only offer plain HTTP, so cleartext traffic is allowed app-wide. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- User-installed CAs (e.g. for a debugging proxy) are trusted in debug builds only. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
